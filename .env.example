# =========================================================================
# OpsFlow — local development environment variables (example)
# Copy this file to ".env" and adjust as needed. NEVER commit the real .env.
#
# Phase 0 keeps this file minimal. Additional variables (JWT, file storage,
# mail, etc.) will be introduced in the phases that actually consume them.
# =========================================================================

# ---- SQL Server (local Docker container, introduced with docker-compose) ----
# Host port is 14330 (not the default 1433) so OpsFlow can coexist with any
# other local SQL Server instance already bound to 1433. The container still
# listens on 1433 internally; only the published host port differs.
MSSQL_SA_PASSWORD=OpsFlow_Local!Passw0rd
MSSQL_PORT=14330
OPSFLOW_DB_NAME=OpsFlow

# ---- Database connection string used by the API ----
ConnectionStrings__Default=Server=localhost,14330;Database=OpsFlow;User Id=sa;Password=OpsFlow_Local!Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=True

# ---- ASP.NET Core ----
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5080

# ---- Frontend (Vite dev server) ----
FRONTEND_PORT=5173
