# =========================================================================
# OpsFlow — Docker Compose environment template
# Copy this file to ".env" (git-ignored) for `docker compose`.
# NEVER commit a real .env.
#
# This file configures ONLY docker-compose.yml (the local SQL Server
# container). The ASP.NET Core API does NOT read .env — it reads its
# configuration (connection string, JWT signing key, seed password) from
# ASP.NET Core user secrets or environment variables. See the README.
# =========================================================================

# ---- SQL Server container (consumed by docker-compose.yml) ----
# Host port is 14330 (not the default 1433) so OpsFlow can coexist with any
# other local SQL Server already bound to 1433. The container listens on 1433
# internally; only the published host port differs.
MSSQL_SA_PASSWORD=OpsFlow_Local!Passw0rd
MSSQL_PORT=14330
