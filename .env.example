# =========================================================================
# OpsFlow — Docker Compose environment template
# Copy this file to ".env" (git-ignored) for `docker compose`.
# NEVER commit a real .env.
# =========================================================================

# ---- SQL Server ----
# Host port is 14330 (not the default 1433) so OpsFlow can coexist with any
# other local SQL Server already bound to 1433. The container listens on 1433
# internally; only the published host port differs.
MSSQL_SA_PASSWORD=OpsFlow_Local!Passw0rd
MSSQL_PORT=14330

# ---- API ----
# JWT signing key (minimum 32 characters for HS256)
JWT_SIGNING_KEY=T3BzRmxvd0xvY2FsRGV2U2lnbmluZ0tleUNoYW5nZU1l

# Apply EF Core migrations on API startup (default: true for local compose)
APPLY_MIGRATIONS=true

# OpenAI (optional — leave blank to disable embedding/answer generation)
# OpenAI__ApiKey=sk-...
# OpenAI__EmbeddingModel=text-embedding-3-small
# OpenAI__AnswerModel=gpt-4o-mini

# AWS Bedrock reranking (optional — leave blank to disable)
# BedrockReranker__Region=eu-central-1

# ---- Frontend ----
# Host port for the web container
WEB_PORT=3000
