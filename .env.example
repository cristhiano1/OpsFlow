# =========================================================================
# OpsFlow — Docker Compose environment template
# Copy this file to ".env" (git-ignored) for `docker compose`.
# NEVER commit a real .env.
# =========================================================================

# ---- SQL Server ----
# Replace these placeholder values in your local .env.
MSSQL_SA_PASSWORD=CHANGE_ME_LOCAL_SQL_PASSWORD
MSSQL_PORT=14330

# ---- API / local demo bootstrap ----
# Compose defaults to Development so a fresh stack can create demo users.
# For production-like runs set ASPNETCORE_ENVIRONMENT=Production and
# SEED_ENABLED=false.
ASPNETCORE_ENVIRONMENT=Development
SEED_ENABLED=true
SEED_DEFAULT_PASSWORD=CHANGE_ME_LOCAL_DEMO_PASSWORD

# JWT signing key (minimum 32 characters for HS256)
JWT_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SIGNING_KEY

# Apply EF Core migrations on API startup (default: true for local compose)
APPLY_MIGRATIONS=true

# OpenAI (required for embeddings / grounded answer generation)
# Leave blank only if you intentionally want those features unavailable.
OpenAI__ApiKey=
OpenAI__EmbeddingModel=text-embedding-3-small
OpenAI__AnswerModel=gpt-4o-mini

# AWS Bedrock reranking (optional; reranking remains disabled by default)
BedrockReranker__Region=eu-central-1
BedrockReranker__ModelId=cohere.rerank-v3-5:0
BedrockReranker__TimeoutSeconds=30
Reranking__ActivateInAnswerPath=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1

# ---- Frontend ----
WEB_PORT=3000
