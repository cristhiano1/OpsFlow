# =========================================================================
# OpsFlow — Production environment template
#
# Copy to .env in the deployment directory:
#   cp .env.production.example .env
#
# Replace every CHANGE_ME value before starting the stack.
# NEVER commit the real .env file.
# =========================================================================

# ---- Domain ----
# The public domain where OpsFlow will be served. Caddy uses this for
# automatic TLS certificate provisioning via ACME (Let's Encrypt).
OPSFLOW_DOMAIN=CHANGE_ME_demo.example.com

# ---- SQL Server (Express edition) ----
# Strong password required: 8+ chars, uppercase, lowercase, digit, symbol.
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_SA_PASSWORD

# ---- API ----
# JWT signing key: base64-encoded, minimum 32 bytes of random data.
# Generate with:
#   openssl rand -base64 32
JWT_SIGNING_KEY=CHANGE_ME_BASE64_JWT_KEY

# ---- Demo seeding ----
# Set to true to create demo accounts on first startup.
# The DevelopmentDataSeeder creates orgs and users idempotently.
SEED_DEMO_DATA=true

# Password for seeded demo accounts (viewer, coordinator, admin).
# Required when SEED_DEMO_DATA=true.
SEED_DEFAULT_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# ---- Container images ----
# GHCR image references pinned to exact commit-SHA tags.
# The deploy workflow sets these automatically. For manual deployment,
# build locally and set to the local image names, e.g.:
#   OPSFLOW_API_IMAGE=opsflow-api:local
#   OPSFLOW_WEB_IMAGE=opsflow-web:local
OPSFLOW_API_IMAGE=CHANGE_ME_ghcr.io/owner/opsflow-api:sha-xxxxxxxx
OPSFLOW_WEB_IMAGE=CHANGE_ME_ghcr.io/owner/opsflow-web:sha-xxxxxxxx

# ---- OpenAI ----
# Required for embedding generation and grounded answer generation.
# Without this key, document upload will store files but embedding/RAG
# features will be unavailable.
OpenAI__ApiKey=CHANGE_ME_OPENAI_API_KEY
OpenAI__EmbeddingModel=text-embedding-3-small
OpenAI__AnswerModel=gpt-4o-mini

# ---- AWS Bedrock reranking (optional) ----
# Reranking is disabled by default. To enable, set
# Reranking__ActivateInAnswerPath=true and provide AWS credentials.
Reranking__ActivateInAnswerPath=false
BedrockReranker__Region=eu-central-1
BedrockReranker__ModelId=cohere.rerank-v3-5:0
BedrockReranker__TimeoutSeconds=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1
