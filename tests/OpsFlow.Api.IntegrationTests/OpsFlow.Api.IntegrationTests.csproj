<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test-only conventions (this project is entirely test code):
         CS1591 (no XML docs), CA1707 (underscores in test names),
         CA1711 (xUnit collection marker ends in "Collection"),
         IDE1006 (xUnit async test methods do not use the "Async" suffix),
         IDE0058 (EF Core Add/SaveChanges/Remove discard their return value),
         IDE0290 (xUnit fixture test classes use explicit constructors). -->
    <NoWarn>$(NoWarn);CS1591;CA1707;CA1711;IDE1006;IDE0058;IDE0290</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\OpsFlow.Infrastructure\OpsFlow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
